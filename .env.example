# Rails does not load this file automatically. Export these variables in your
# shell or copy them into your environment manager. Never put real secrets here.

# Local development and test database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orbit
POSTGRES_PASSWORD=replace-with-a-local-password

# Production database URL supplied by the hosting provider
DATABASE_URL=postgresql://orbit_user:replace-me@db.example.com:5432/orbit_production

# Required production settings
RAILS_MASTER_KEY=replace-with-the-key-from-config-master-key
APP_HOST=orbit.example.com

# Optional one-time initial admin creation through `bin/rails db:seed`.
# Omit all three variables when production should not create an admin.
ORBIT_ADMIN_EMAIL=owner@example.com
ORBIT_ADMIN_USERNAME=owner
ORBIT_ADMIN_PASSWORD=replace-with-a-unique-password-manager-generated-value

# Optional production tuning
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
SOLID_QUEUE_IN_PUMA=true
